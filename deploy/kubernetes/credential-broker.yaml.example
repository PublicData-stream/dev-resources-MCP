# Replace DEVRES_NAMESPACE, image digest and destination CIDRs before applying.
# Requires native Secrets encryption at rest, an admitted issuer receipt and a
# separate broker database. Secrets are operator-created and never templated here.
apiVersion: v1
kind: ServiceAccount
metadata: {name: devres-credential-broker, namespace: DEVRES_NAMESPACE}
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata: {name: DEVRES_NAMESPACE-credential-reviewer}
rules:
  - apiGroups: [authentication.k8s.io]
    resources: [tokenreviews]
    verbs: [create]
  - apiGroups: ['']
    resources: [namespaces]
    resourceNames: [kube-system]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata: {name: DEVRES_NAMESPACE-credential-reviewer}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: DEVRES_NAMESPACE-credential-reviewer}
subjects:
  - {kind: ServiceAccount, name: devres-credential-broker, namespace: DEVRES_NAMESPACE}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: devres-broker-live-identities, namespace: DEVRES_NAMESPACE}
rules:
  - apiGroups: ['']
    resources: [pods, serviceaccounts]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: devres-broker-live-identities, namespace: DEVRES_NAMESPACE}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: devres-broker-live-identities}
subjects:
  - {kind: ServiceAccount, name: devres-credential-broker, namespace: DEVRES_NAMESPACE}
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: credential-broker, namespace: DEVRES_NAMESPACE}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector: {matchLabels: {app: credential-broker}}
  template:
    metadata: {labels: {app: credential-broker}}
    spec:
      serviceAccountName: devres-credential-broker
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: broker
          image: ghcr.io/publicdata-stream/dev-resources-credential-broker@sha256:DEVRES_IMAGE_DIGEST
          args: [/etc/devres/credential-broker.toml]
          ports: [{name: credentials, containerPort: 9444}]
          readinessProbe:
            httpGet: {path: /healthz, port: credentials, scheme: HTTPS}
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: '1', memory: 256Mi}
          volumeMounts:
            - {name: config, mountPath: /etc/devres, readOnly: true}
            - {name: private, mountPath: /run/devres-broker, readOnly: true}
            - {name: kube, mountPath: /run/devres-kube, readOnly: true}
      volumes:
        - name: config
          configMap: {name: devres-credential-broker}
        - name: private
          secret: {secretName: devres-credential-broker-private, defaultMode: 0440}
        - name: kube
          projected:
            defaultMode: 0440
            sources:
              - serviceAccountToken: {path: token, expirationSeconds: 3600}
              - configMap:
                  name: kube-root-ca.crt
                  items: [{key: ca.crt, path: ca.crt}]
---
apiVersion: v1
kind: Service
metadata: {name: credential-broker, namespace: DEVRES_NAMESPACE}
spec:
  selector: {app: credential-broker}
  ports: [{name: credentials, port: 9444, targetPort: credentials}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: credential-broker-boundary, namespace: DEVRES_NAMESPACE}
spec:
  podSelector: {matchLabels: {app: credential-broker}}
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - podSelector: {matchLabels: {app: backend}}
        - podSelector: {matchLabels: {app: writer}}
      ports: [{port: 9444, protocol: TCP}]
  egress:
    - to: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: kube-system}}}]
      ports: [{port: 53, protocol: UDP}, {port: 53, protocol: TCP}]
    - to: [{podSelector: {matchLabels: {app: postgres}}}]
      ports: [{port: 5432, protocol: TCP}]
    - to: [{ipBlock: {cidr: DEVRES_KUBERNETES_API_CIDR}}, {ipBlock: {cidr: DEVRES_SCALEWAY_IAM_CIDR}}]
      ports: [{port: 443, protocol: TCP}, {port: 6443, protocol: TCP}]
