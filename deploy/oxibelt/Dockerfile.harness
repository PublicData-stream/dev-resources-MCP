# Native fixture binaries are copied only from a verified build into this image.
FROM ubuntu:26.04@sha256:513c074113a871b51a8d16ab445c88779d6452d937a164fb5cc479f32668a41d
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 curl \
    && rm -rf /var/lib/apt/lists/*
COPY bin/ /usr/local/bin/
COPY scripts/ /harness/
WORKDIR /fixture
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/devres-server"]
CMD ["/fixture/backend.toml"]
