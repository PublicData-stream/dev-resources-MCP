{
  "Version": "2023-04-17",
  "Statement": [
    {
      "Sid": "readonlyObjects",
      "Effect": "Allow",
      "Principal": {
        "SCW": "application_id:00000000-0000-0000-0000-000000000002"
      },
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "devres-archive/production/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "IpAddress": {
          "aws:SourceIp": [
            "192.0.2.1/32"
          ]
        }
      }
    },
    {
      "Sid": "readonlyListing",
      "Effect": "Allow",
      "Principal": {
        "SCW": "application_id:00000000-0000-0000-0000-000000000002"
      },
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "devres-archive"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "StringLike": {
          "s3:prefix": [
            "production/*"
          ]
        },
        "IpAddress": {
          "aws:SourceIp": [
            "192.0.2.1/32"
          ]
        }
      }
    }
  ]
}
