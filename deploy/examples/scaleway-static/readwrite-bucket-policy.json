{
  "Version": "2023-04-17",
  "Statement": [
    {
      "Sid": "readwriteObjects",
      "Effect": "Allow",
      "Principal": {
        "SCW": "application_id:00000000-0000-0000-0000-000000000003"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "devres-archive/production/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "IpAddress": {
          "aws:SourceIp": [
            "192.0.2.1/32"
          ]
        }
      }
    },
    {
      "Sid": "readwriteListing",
      "Effect": "Allow",
      "Principal": {
        "SCW": "application_id:00000000-0000-0000-0000-000000000003"
      },
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "devres-archive"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "StringLike": {
          "s3:prefix": [
            "production/*"
          ]
        },
        "IpAddress": {
          "aws:SourceIp": [
            "192.0.2.1/32"
          ]
        }
      }
    }
  ]
}
