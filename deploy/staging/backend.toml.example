# This template is not usable until the private database placeholder is replaced.
# Keep populated configuration in the root-owned runtime Secret, never in Git.
[source]
url = "https://github.com/PublicData-stream/dev-resources-MCP/releases/download/0.1.0-build.78c2e9c5/source.tar.gz"

# First qualify transport, live fixed records, and coordinated restore with all
# collectors paused. Configure Wikipedia's operator identity before activating
# its collector; activation then changes these nine booleans to true.
[rfc]
enabled = false
[crates]
enabled = false
[rustsec]
enabled = false
[mdn]
enabled = false
[whatwg]
enabled = false
[w3c]
enabled = false
[chromium]
enabled = false
[wikipedia]
enabled = false
# Configure an honest operator identity before enabling Wikipedia network activity.
# user_agent = "ExampleBot/1.0 (https://example.org/bot; operator@example.org)"
# oauth2_token_file = "/run/secrets/wikipedia-oauth2-token"
[npm]
enabled = false
packages = []

[http]
bind = "0.0.0.0:8080"
allowed_hosts = ["devres-k8s:30081"]
allowed_origins = ["https://chatgpt.com", "https://dev-resources.staged.mcp.publicdata.stream"]
[http.tls]
certificate = "/etc/devres/tls/backend.pem"
private_key = "/etc/devres/tls/backend-key.pem"

[webtransport]
bind = "0.0.0.0:4433"
certificate = "/etc/devres/tls/backend.pem"
private_key = "/etc/devres/tls/backend-key.pem"
allowed_hosts = ["devres-k8s:30434"]
allowed_origins = ["https://chatgpt.com", "https://dev-resources.staged.mcp.publicdata.stream"]

[health]
bind = "0.0.0.0:9090"
[storage]
database_url = "REPLACE_WITH_PRIVATE_POSTGRES_URL"
blob_dir = "/data/blobs"
[edge_mtls]
client_ca_file = "/etc/devres/tls/client-ca.pem"
required_client_dns_san = "devres-edge.internal"
